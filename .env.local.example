# ── App ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=18005550148

# ── Database (PostgreSQL) ────────────────────────────
# REQUIRED in production
DATABASE_URL=postgresql://user:password@localhost:5432/hajamed?schema=public

# ── Clerk ────────────────────────────────────────────
# REQUIRED in production
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/account
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/account

# ── Stripe ───────────────────────────────────────────
# REQUIRED in production
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Cloudinary ───────────────────────────────────────
# Recommended in production (admin image uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (Resend) ───────────────────────────────────
# Recommended in production (orders + contact)
RESEND_API_KEY=
EMAIL_FROM="VARENO <orders@yourdomain.com>"
ADMIN_NOTIFICATION_EMAIL=concierge@hajamed.com

# ── Admin authorization ──────────────────────────────
# Comma-separated emails granted ADMIN (in addition to Clerk publicMetadata.role=admin)
ADMIN_EMAILS=you@yourdomain.com

# ── Ops ──────────────────────────────────────────────
# Set to 1 only for CI builds that intentionally omit secrets
# SKIP_ENV_VALIDATION=1
